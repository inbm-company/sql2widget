APP_ENV=development
APP_SECRET=dev-secret-replace-with-at-least-32-chars!!
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

POSTGRES_USER=agent4any
POSTGRES_PASSWORD=agent4any
POSTGRES_DB=agent4any
CUSTOMER_POSTGRES_DB=agent4any_customer_demo
NORTHWIND_POSTGRES_DB=agent4any_northwind
SKAX_NMS_POSTGRES_DB=agent4any_skax_nms
CHAT_VECTOR_POSTGRES_DB=agent4any_chat_vector

# Neo4j 로컬 그래프 DB — 임의의 비밀번호를 지정 (최소 8자, 기본 계정 neo4j)
NEO4J_PASSWORD=

DATABASE_URL=postgresql://agent4any:agent4any@db:5432/agent4any
DEMO_CUSTOMER_DATABASE_URL=postgresql://agent4any:agent4any@db-customer:5432/agent4any_customer_demo
NORTHWIND_DATABASE_URL=postgresql://agent4any:agent4any@db-northwind:5432/agent4any_northwind
SKAX_NMS_DATABASE_URL=postgresql://agent4any:agent4any@db-skax-nms:5432/agent4any_skax_nms
# 채팅 메시지 임베딩(유사도 검색) 전용 DB — pgvector 확장 사용
CHAT_VECTOR_DATABASE_URL=postgresql://agent4any:agent4any@db-chat-vector:5432/agent4any_chat_vector
# 임베딩 모델을 정하면 해당 모델의 차원 수로 변경 (예: OpenAI text-embedding-3-small=1536, -large=3072)
CHAT_EMBEDDING_DIM=1536

LLM_PROVIDER=mock
# openai | mock  — API 키 없으면 자동으로 mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
VITE_API_BASE=http://127.0.0.1:8010
